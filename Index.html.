<!doctype html><html lang="da"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#111827"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="ELBERG PAL"><title>ELBERG · PAL beregner</title><style>body{margin:0;background:#edf1f5;color:#17202d;font:16px system-ui}main{max-width:650px;margin:auto;padding:18px}header{background:#111827;color:white;padding:26px;border-radius:18px;text-align:center;letter-spacing:2px}header small{display:block;letter-spacing:1px;color:#aeb8c7}section{background:white;border-radius:16px;padding:18px;margin-top:14px;box-shadow:0 2px 12px #0001}h2{font-size:18px;margin:0 0 14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:block;font-size:13px;font-weight:650;margin-bottom:4px}input,select{box-sizing:border-box;width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:9px;font-size:16px;background:white}.activity{display:grid;grid-template-columns:1fr 85px;gap:10px;align-items:center;margin:10px 0}.results{display:grid;grid-template-columns:1fr 1fr;gap:10px}.metric{background:#f1f5f9;border-radius:12px;padding:14px}.metric b{display:block;font-size:24px}.metric small{color:#526074}button{border:0;background:#17202d;color:white;padding:13px;border-radius:10px;font-size:15px;cursor:pointer;margin-top:10px}button.secondary{background:#e2e8f0;color:#17202d}p.note{font-size:12px;color:#64748b;line-height:1.5}.warn{color:#b91c1c;font-weight:650}#summary{display:none}@media print{button{display:none}body{background:white}section{box-shadow:none;border:1px solid #ddd}}</style><main><header><strong style="font-size:28px">ELBERG</strong><small>HUMAN PERFORMANCE</small><small>PAL · ENERGIBEREGNER</small></header><section><h2>Personoplysninger</h2><div class="grid"><div><label>Navn / klient-ID</label><input id="name" placeholder="Valgfrit"></div><div><label>Køn (BMR-formel)</label><select id="sex"><option value="m">Mand</option><option value="f">Kvinde</option></select></div><div><label>Alder (år)</label><input id="age" type="number" value="42" min="10"></div><div><label>Vægt (kg)</label><input id="weight" type="number" value="86" step="0.1" min="1"></div><div><label>Højde (cm)</label><input id="height" type="number" value="186" min="1"></div><div><label>Mål</label><select id="goal"><option value="250">Lean bulk (+250)</option><option value="0">Vedligehold</option><option value="-400">Cut (−400)</option></select></div></div></section><section><h2>Fordel 24 timer i døgnet</h2><div id="activities"></div><p id="hours"></p></section><section><h2>Beregning</h2><div class="results"><div class="metric"><small>PAL</small><b id="pal">—</b></div><div class="metric"><small>BMR · kcal</small><b id="bmr">—</b></div><div class="metric"><small>TDEE · kcal</small><b id="tdee">—</b></div><div class="metric"><small>Kaloriemål · kcal</small><b id="target">—</b></div></div><p id="macros"></p><button onclick="window.print()">Udskriv / gem PDF</button> <button class="secondary" onclick="save()">Gem profil på denne enhed</button> <button class="secondary" onclick="load()">Indlæs profil</button><p class="note">BMR: Mifflin–St Jeor. PAL: tidsvægtet aktivitetsestimat (MET-lignende aktivitetsfaktorer). BMR × PAL er kun et udgangspunkt; kalibrér efter vægtudvikling over 2–3 uger. Aktiviteter skal fordeles uden overlap. Profil gemmes kun lokalt i browseren; undgå personfølsomme oplysninger på delte enheder.</p></section></main><script>const acts=[['Søvn',.95,8],['Stillesiddende',1.3,8],['Gang',3,1],['Styrketræning',5,1],['Let aktivitet',1.6,6]];document.querySelector('#activities').innerHTML=acts.map((a,i)=>`<div class="activity"><div><label>${a[0]} · faktor ${a[1]}</label></div><input id="h${i}" type="number" min="0" max="24" step="0.5" value="${a[2]}"></div>`).join('');function val(id){return +document.getElementById(id).value}function calc(){let hrs=acts.map((a,i)=>val('h'+i)),total=hrs.reduce((a,b)=>a+b,0),valid=Math.abs(total-24)<.001&&hrs.every(v=>v>=0&&v<=24)&&val('weight')>0&&val('height')>0&&val('age')>0;document.querySelector('#hours').textContent=`I alt: ${total.toLocaleString('da-DK')} / 24 timer`+(valid?'':' — ret timer eller persondata');document.querySelector('#hours').className=valid?'':'warn';let ids=['pal','bmr','tdee','target'];if(!valid){ids.forEach(id=>document.getElementById(id).textContent='—');document.querySelector('#macros').textContent='';return}let pal=hrs.reduce((s,h,i)=>s+h*acts[i][1],0)/24,bmr=10*val('weight')+6.25*val('height')-5*val('age')+(document.querySelector('#sex').value==='m'?5:-161),tdee=pal*bmr,target=tdee+val('goal'),p=1.8*val('weight'),f=.8*val('weight'),c=Math.max(0,(target-4*p-9*f)/4);[pal.toFixed(2),Math.round(bmr),Math.round(tdee),Math.round(target)].forEach((v,i)=>document.getElementById(ids[i]).textContent=Number(v).toLocaleString('da-DK'));document.querySelector('#macros').textContent=`Makroer: protein ${Math.round(p)} g · fedt ${Math.round(f)} g · kulhydrat ${Math.round(c)} g`;}document.querySelectorAll('input,select').forEach(e=>e.addEventListener('input',calc));function save(){let data={};document.querySelectorAll('input,select').forEach(e=>data[e.id]=e.value);try{localStorage.setItem('elberg_pal_profile',JSON.stringify(data));alert('Profil gemt lokalt på denne enhed.')}catch(e){alert('Denne visning tillader ikke lokal lagring. Åbn beregneren i Safari via en hjemmeside.')}}function load(){let data={};try{data=JSON.parse(localStorage.getItem('elberg_pal_profile')||'{}')}catch(e){alert('Profilen kan ikke indlæses i denne visning.');return}Object.entries(data).forEach(([k,v])=>{let el=document.getElementById(k);if(el)el.value=v});calc()}calc();</script></html>
